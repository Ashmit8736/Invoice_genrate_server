generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Settings {
  id           Int      @id @default(autoincrement())
  company_name String   @db.VarChar(255)
  address      String   @db.Text
  gstin        String   @db.VarChar(50)
  pan          String   @db.VarChar(50)
  state_code   String   @db.VarChar(10)
  updated_at   DateTime @default(now()) @updatedAt

  @@map("settings")
}

model Customer {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(255)
  shipping_address String    @db.Text
  phone            String    @db.VarChar(20)
  gstin            String?   @db.VarChar(50)
  state_code       String    @db.VarChar(10)
  created_at       DateTime  @default(now())
  invoices         Invoice[]

  @@map("customers")
}

model Invoice {
  id               Int           @id @default(autoincrement())
  order_id         String        @db.VarChar(100)
  invoice_date     DateTime      @db.Date
  payment_mode     String        @db.VarChar(50)
  fulfillment_type String        @db.VarChar(50)
  status           String        @default("Paid") @db.VarChar(50)
  customer_id      Int?
  net_subtotal     Decimal       @db.Decimal(10, 2)
  cgst_amount      Decimal?      @default(0) @db.Decimal(10, 2)
  sgst_amount      Decimal?      @default(0) @db.Decimal(10, 2)
  igst_amount      Decimal?      @default(0) @db.Decimal(10, 2)
  total_amount     Decimal       @db.Decimal(10, 2)
  amount_in_words  String?       @db.VarChar(255)
  created_at       DateTime      @default(now())
  
  customer         Customer?     @relation(fields: [customer_id], references: [id])
  items            InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id            Int      @id @default(autoincrement())
  invoice_id    Int?
  description   String   @db.VarChar(255)
  supplier_name String?  @db.VarChar(255)
  quantity      Int
  unit_price    Decimal  @db.Decimal(10, 2)
  gst_rate      Decimal  @db.Decimal(5, 2)
  total         Decimal  @db.Decimal(10, 2)

  invoice       Invoice? @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}
